# Backend Go al que el proxy /api/* reenvía las peticiones (y que usa el renderizado en servidor).
# En Docker (docker-compose.prod.yml) es http://backend:8081.
INTERNAL_API_URL=http://localhost:8081

# Opcional: URL de Go para las peticiones del navegador, sin pasar por el proxy /api/*.
# Requiere que el origen del frontend esté en ALLOWED_ORIGINS del backend (p. ej. http://localhost:3000).
# NEXT_PUBLIC_API_URL=http://localhost:8081
